# Local development can run without network or a real key.
MOLING_ENV=development
MODEL_PROVIDER=fake

# Production: set MODEL_PROVIDER=deepseek and inject both secrets through the
# deployment platform. Never commit real values to this file.
DEEPSEEK_API_KEY=
PROVIDER_USER_ID_SALT=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_DEFAULT_MAX_TOKENS=420
DEEPSEEK_DEEP_MAX_TOKENS=800
DEEPSEEK_TIMEOUT_SECONDS=40
DEEPSEEK_RETRY_COUNT=1

# Vision is an explicit development fallback only. Production validation
# rejects either switch when enabled.
VISION_FALLBACK_ENABLED=false
DEBUG_IMAGE_SAVE_ENABLED=false
LOG_LEVEL=INFO
