# Local development defaults. Production must override every value marked
# REQUIRED and must use MODEL_PROVIDER=deepseek plus PostgreSQL.
MOLING_ENV=development
MODEL_PROVIDER=fake
DATABASE_URL=sqlite:///./moling.db

# REQUIRED production secrets (deployment secret manager only).
DEEPSEEK_API_KEY=
PROVIDER_USER_ID_SALT=development-only-salt
TOKEN_HASH_PEPPER=development-only-token-pepper

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_DEFAULT_MAX_TOKENS=420
DEEPSEEK_DEEP_MAX_TOKENS=800
DEEPSEEK_TIMEOUT_SECONDS=40
DEEPSEEK_RETRY_COUNT=1

# Authentication, registration, rate, quota, lease, and budget values are
# deployment controls, not frozen commercial-plan values. Production startup
# rejects them unless each is explicitly configured.
ACCESS_TOKEN_TTL_SECONDS=2592000
REGISTRATION_ENABLED=true
REGISTRATION_REQUESTS_PER_MINUTE=30
REGISTRATION_MAX_PRINCIPALS=10000
PRINCIPAL_REQUESTS_PER_MINUTE=10
PRINCIPAL_DAILY_REQUEST_LIMIT=50
PRINCIPAL_MONTHLY_REQUEST_LIMIT=500
GLOBAL_MONTHLY_BUDGET_CNY=300
REQUEST_LEASE_SECONDS=90
REQUEST_MAX_ATTEMPTS=3
REQUEST_COST_RESERVATION_CNY=0.05

VISION_FALLBACK_ENABLED=false
DEBUG_IMAGE_SAVE_ENABLED=false
LOG_LEVEL=INFO
